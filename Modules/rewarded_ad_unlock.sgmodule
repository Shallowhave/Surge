#!name = 激励视频解锁(穿山甲)
#!desc = 打断穿山甲广告音频流, 触发App兜底发奖, 跳过激励视频倒计时. 配合MITM+禁QUIC, 让广告无法播放.
#!author = memory

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao-b.com, *.pangolin-sdk-toutiao1.com, *.pglstatp-toutiao.com, *.ugdtimg.com, *.gdt.qq.com, *.pgdt.gtimg.cn, *.mssdk.volces.com

[Rule]
AND,((OR,((DOMAIN-SUFFIX,pangolin-sdk-toutiao.com),(DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com),(DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com),(DOMAIN-SUFFIX,pglstatp-toutiao.com),(DOMAIN-SUFFIX,ugdtimg.com),(DOMAIN-SUFFIX,gdt.qq.com),(DOMAIN-SUFFIX,pgdt.gtimg.cn),(DOMAIN-SUFFIX,mssdk.volces.com))),(PROTOCOL,QUIC)),REJECT

[Map Local]
^https?:\/\/.*pglstatp-toutiao\.com\/.*video.* data-type=text data="" header="Content-Type: video/mp4" status-code=200
